# Esper (careai.esper.cloud)
# Create API key in Esper Console → API Management. Enterprise ID is in the same section.
ESPER_BASE_URL=https://careai-api.esper.cloud/api
ESPER_API_KEY=
ESPER_ENTERPRISE_ID=
# If you get 401, try: ESPER_AUTH_TYPE=ApiKey  or  ESPER_AUTH_TYPE=X-Api-Key
ESPER_AUTH_TYPE=Bearer

# Confluence – Device Apps page (same Atlassian account as Jira)
# Use JIRA_* from jira-dashboard if same Atlassian account.
CONFLUENCE_URL=https://careai.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Page ID from URL: .../pages/2097741847/Device+Apps
CONFLUENCE_DEVICE_APPS_PAGE_ID=2097741847
