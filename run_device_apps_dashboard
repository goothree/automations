#!/usr/bin/env bash
# Start the Device Apps Dashboard (Esper vs Confluence) and open in Chrome.
# Run from project root: ./run_device_apps_dashboard
# Requires device-apps-dashboard/.env (see .env.example)

set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

PYTHON=python
if [ -d ".venv" ]; then
  PYTHON=./.venv/bin/python
elif [ -d "venv" ]; then
  PYTHON=./venv/bin/python
fi
if [ "$PYTHON" != "python" ]; then
  echo "Ensuring dependencies are installed..."
  $PYTHON -m pip install -q -r "$ROOT/device-apps-dashboard/requirements.txt" 2>/dev/null || true
fi

SERVER_PY="$ROOT/device-apps-dashboard/server.py"
if [ ! -f "$SERVER_PY" ]; then
  echo "Error: device-apps-dashboard/server.py not found at $SERVER_PY" >&2
  exit 1
fi

PORT=${PORT:-5558}
ERR=$(mktemp)
PID=
cleanup() {
  rm -f "$ERR"
  if [ -n "$PID" ]; then
    kill -TERM -"$PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# Cycle ports if default is taken
set -m
while true; do
  echo "Starting Device Apps Dashboard at http://127.0.0.1:$PORT"
  PORT=$PORT $PYTHON "$SERVER_PY" 2>"$ERR" &
  PID=$!
  sleep 2
  if kill -0 "$PID" 2>/dev/null; then
    break
  fi
  if grep -qE "Address already in use|port is already in use|Errno 48|OSError.*\[Errno 48\]" "$ERR" 2>/dev/null; then
    echo "Port $PORT in use, trying $((PORT+1))..."
    PORT=$((PORT+1))
  else
    echo "Server failed to start:" >&2
    cat "$ERR" >&2
    exit 1
  fi
done
set +m

# Open in Chrome by default; fall back to default browser if Chrome not found
OPEN_URL="http://127.0.0.1:$PORT"
if [[ "$(uname)" == "Darwin" ]]; then
  if [ -d "/Applications/Google Chrome.app" ]; then
    open -a "Google Chrome" "$OPEN_URL"
  else
    open "$OPEN_URL"
  fi
elif command -v google-chrome &>/dev/null; then
  google-chrome "$OPEN_URL" &>/dev/null &
elif command -v google-chrome-stable &>/dev/null; then
  google-chrome-stable "$OPEN_URL" &>/dev/null &
else
  echo "Dashboard running at $OPEN_URL (open in your browser)"
fi

wait $PID
