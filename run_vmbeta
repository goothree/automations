#!/usr/bin/env bash
# Run the Virtual Monitoring * test (login + open VM* from overflow menu).
# Creates screenshots/<timestamp>/ and writes pytest output to run_vmbeta.log there.
set -eo pipefail
cd "$(dirname "$0")"
RUN_DIR="$(pwd)/screenshots/$(date +%Y%m%d_%H%M%S)"
mkdir -p "$RUN_DIR"
export VMBETA_SCREENSHOT_RUN_DIR="$RUN_DIR"
LOG_FILE="$RUN_DIR/run_vmbeta.log"

if [[ -x .venv/bin/pytest ]]; then
  .venv/bin/pytest src/tests/vmbeta.py::test_vmbeta -v "$@" 2>&1 | tee "$LOG_FILE"
else
  pytest src/tests/vmbeta.py::test_vmbeta -v "$@" 2>&1 | tee "$LOG_FILE"
fi
