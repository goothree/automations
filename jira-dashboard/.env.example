# Jira Cloud: use your Atlassian account email and an API token.
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token

# Optional: restrict to a single project key (e.g. IDA). Leave empty for the QA queue below.
JIRA_PROJECT=

# Optional: JQL filter for "my team". Use single quotes so the whole value is read (required if JQL has spaces).
# Example: JIRA_TEAM_JQL='project = IDA AND status = "In QA" ORDER BY updated DESC'
# Leave empty for the default queue: IDA in "In QA", RDAR in "In Testing", and unresolved QA issues.
JIRA_TEAM_JQL=

# Jira → Testpad: custom field ID for "Test Script" (e.g. customfield_10100). Find in Jira Admin → Custom fields.
JIRA_TEST_SCRIPT_FIELD_ID=
# Optional: custom field ID for "Acceptance Criteria". Used when generating test steps from the ticket.
# JIRA_AC_FIELD_ID=customfield_10xxx
# Optional: custom field ID for "Approvers". Defaults to customfield_10003 on care.ai Jira.
# JIRA_APPROVERS_FIELD_ID=customfield_10003
# Assigned filter uses members of this Atlassian team. Defaults are the care.ai QA team.
# JIRA_QA_TEAM_NAME=QA
# JIRA_ORG_ID=7813343c-4f17-48f6-8239-4455660568b6

# Testpad API (must be enabled by Testpad Support; token from account owner).
TESTPAD_BASE_URL=https://api.testpad.com/api/v1
TESTPAD_API_TOKEN=
TESTPAD_PROJECT_ID=6
TESTPAD_FOLDER_ID=
# IDA-* scripts go in f197. RDAR-* scripts go in f198.
TESTPAD_FOLDER_IDA=f197
TESTPAD_FOLDER_RDAR=f198
# Upper-level folders already seen, "id:name" records separated by "|".
# A new upper-level folder (for example v2026-12) prompts for new IDA and RDAR folders before scripts are created.
TESTPAD_KNOWN_UPPER_FOLDERS=
TESTPAD_UI_BASE_URL=https://vuaant.testpad.com
# Optional: exact script URL pattern. Open a script in the browser, copy the URL, replace the script id with {script_id}.
# Example: https://vuaant.testpad.com/project/6/folder/12/script/123 -> TESTPAD_SCRIPT_URL_TEMPLATE=https://vuaant.testpad.com/project/6/folder/12/script/{script_id}
TESTPAD_SCRIPT_URL_TEMPLATE=

# LLM fallback for generating test steps (OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SharePoint test plan folder (shared with QA). Defaults in config.py match these paths.
# Override only if you intentionally use a different sync location.
TEST_PLAN_SHAREPOINT_FOLDER_URL=https://stryker-my.sharepoint.com/:f:/p/michael_guthrie/IgBAyEORHosITrKk3lSVFca_AePm9AG_nzqGIQvVf7EbPk0
TEST_PLAN_ONEDRIVE_SYNC_DIR=/Users/michael.guthrie/Library/CloudStorage/OneDrive-Stryker/TestPlans
TEST_PLAN_SHAREPOINT_SITE_BASE=https://stryker-my.sharepoint.com/personal/michael_guthrie_stryker_com
TEST_PLAN_SHAREPOINT_FOLDER_PATH=Documents/TestPlans
