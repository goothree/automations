# Optional: import a Postman environment export (preferred).
# Copy Inbound_Dev.postman_environment.json here — it is gitignored because it contains secrets.
POSTMAN_ENV_PATH=scripts/postman/Inbound_Dev.postman_environment.json

# Or set individual values (override Postman env when both are present):
# CLIENT_ID=
# CLIENT_SECRET=
# AUDIENCE=
# DEV_INBOUND_URL=
# DEV_TENANT=lab
# HCA_FACILITY_MNEMONIC=

# Optional overrides
AUTH_URL=https://dev-auth.care.ai/oauth/token
COLLECTION_PATH=scripts/postman/care.ai_dev.postman_collection.json
# ADMIT_STATE_PATH=scripts/postman/admit_state.json

# Optional fallback for other ADT requests (a08, a13):
# PATIENT_FIRST_NAME=
# PATIENT_LAST_NAME=
# DEVICE_ID=CAI240418489
